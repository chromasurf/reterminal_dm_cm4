#!/bin/sh
# Loads kernel modules before the Erlang VM starts; nerves_uevent coldplugs them only ~1.4 s after the VM
# starts. Measured on a reTerminal DM: vc4 (panel) ready at 2.97 s instead of 5.03 s, v3d at 3.04 s, fb0 at
# 3.38 s instead of 5.31 s. The display path goes first; every other driver that binds then makes the kernel
# retry the deferred vc4. v3d (render only) loads once vc4 holds card0, so the panel is /dev/dri/card0 on
# every boot. Run by erlinit as pre_run_exec; an app with its own pre_run_exec calls it from there. Returns
# at once, the work runs in the background.
(
  TICK=/tmp/.early_modules_tick
  mknod "$TICK" p 2>/dev/null

  # vc4's HDMI bind registers a sound card and defers until hdmi-codec is loaded, and the DSI panel waits
  # for that bind: on the reTerminal fb0 came at 2.55 s instead of 1.68 s.
  modprobe -a vc4 snd-soc-hdmi-codec pwm-bcm2835 i2c-mux-pinctrl 2>/dev/null

  aliases=""
  for f in $(find /sys/devices -name modalias); do
    case "$f" in
      *.v3d/*) ;;
      *) aliases="$aliases $(cat "$f")" ;;
    esac
  done
  modprobe -a $aliases 2>/dev/null &

  # read on an empty FIFO is busybox ash's only sub-second sleep: 20 ms steps, up to 10 s.
  count=0
  while [ ! -e /sys/class/drm/card0 ] && [ $count -lt 500 ]; do
    read -t 0.02 _ <> "$TICK"
    count=$((count + 1))
  done
  rm -f "$TICK"

  modprobe v3d
) &
